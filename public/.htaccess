# ============================================================
#  Redirecciones Canónicas SEO (301) - Alleefrance Web
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forzar HTTPS y quitar www (www.alleefrance.com -> https://alleefrance.com)
  RewriteCond %{HTTP_HOST} ^www\.alleefrance\.com$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://alleefrance.com%{REQUEST_URI} [R=301,L]

  # 2. Redirigir la raíz (/) a /es/ con 301 para consolidar señales SEO y evitar que bots auditen el stub de redirección
  RewriteRule ^$ https://alleefrance.com/es/ [R=301,L]

  # 3. Redirigir rutas antiguas sin prefijo de idioma (/es/) hacia /es/...
  RewriteRule ^(servicios|blog|working-holiday|autor|politica-de-privacidad|terminos-y-condiciones)(/.*)?$ https://alleefrance.com/es/$1$2 [R=301,L]
</IfModule>

# ============================================================
#  Cache Control - Alleefrance Web
#  Evita que el navegador muestre versiones antiguas del sitio
# ============================================================

# --- Archivos HTML: nunca cachear (siempre pedir versión nueva) ---
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# --- Assets de Next.js con hash en el nombre: cachear 1 año ---
# Estos archivos tienen un hash único (ej: abc123.js) generado en cada build
# Por eso es seguro cachearlos por mucho tiempo
<FilesMatch "\.(js|css|woff|woff2|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# --- Imágenes y fuentes: cachear 30 días ---
<FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|avif)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# ============================================================
#  Security headers - Alleefrance Web
#  "always" also applies them to redirects and error responses.
#  HSTS has no "preload" on purpose: it is hard to revert.
# ============================================================
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
