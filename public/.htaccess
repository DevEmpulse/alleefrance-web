# ============================================================
#  Redirecciones Canónicas SEO (301) - Alleefrance Web
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forzar HTTPS y quitar www (www.alleefrance.com -> https://alleefrance.com)
  RewriteCond %{HTTP_HOST} ^www\.alleefrance\.com$ [NC,OR]
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://alleefrance.com%{REQUEST_URI} [R=301,L]

  # 2. Redirigir rutas antiguas sin prefijo de idioma (/es/) hacia /es/...
  RewriteRule ^(servicios|blog|working-holiday|autor|politica-de-privacidad|terminos-y-condiciones)(/.*)?$ https://alleefrance.com/es/$1$2 [R=301,L]
</IfModule>

# ============================================================
#  Cache Control - Alleefrance Web
#  Evita que el navegador muestre versiones antiguas del sitio
# ============================================================

# --- Archivos HTML: nunca cachear (siempre pedir versión nueva) ---
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# --- Assets de Next.js con hash en el nombre: cachear 1 año ---
# Estos archivos tienen un hash único (ej: abc123.js) generado en cada build
# Por eso es seguro cachearlos por mucho tiempo
<FilesMatch "\.(js|css|woff|woff2|ttf|eot)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# --- Imágenes y fuentes: cachear 30 días ---
<FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|avif)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# --- Habilitar el módulo de headers si no está activo ---
<IfModule mod_headers.c>
  # Ya incluido arriba, esto asegura compatibilidad
</IfModule>
